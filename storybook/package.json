{
  "name": "@hlt/react-component-library",
  "version": "1.0.21",
  "description": "React component library with theme customizer",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/index.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style": "./dist/index.css"
  },
  "files": [
    "dist/**/*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.lib.config.ts && tsc",
    "build:types": "tsc -p tsconfig.build.json",
    "build:lib": "npm run build && npm run build:types",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --output-dir storybook-static",
    "prepare": "npm run build:lib"
  },
  "peerDependencies": {
    "clsx": "^2.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^2.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^9.1.3",
    "@storybook/addon-docs": "^9.1.3",
    "@storybook/addon-onboarding": "^9.1.3",
    "@storybook/addon-themes": "^9.1.3",
    "@storybook/react-vite": "^9.1.3",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.0.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "eslint-plugin-storybook": "^9.1.3",
    "postcss": "^8.5.6",
    "storybook": "^9.1.3",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "react",
    "react18",
    "nextjs",
    "nextjs14",
    "components",
    "ui",
    "library",
    "whitelabel",
    "themes",
    "tailwindcss",
    "typescript"
  ],
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "repository": "https://github.com/hl-ticketing/HLT-WEB-COMPONENTS.git",
  "author": "FE Team",
  "license": "MIT",
  "dependencies": {
    "@lexical/code": "^0.49.0",
    "@lexical/html": "^0.49.0",
    "@lexical/link": "^0.49.0",
    "@lexical/list": "^0.49.0",
    "@lexical/react": "^0.49.0",
    "@lexical/rich-text": "^0.49.0",
    "@lexical/selection": "^0.49.0",
    "@lexical/utils": "^0.49.0",
    "dompurify": "^3.4.14",
    "lexical": "^0.49.0",
    "lucide-react": "^0.562.0",
    "react-select": "^5.10.2"
  }
}